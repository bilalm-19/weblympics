node_modules/
dist/
*.log

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem
# LAN mode's certificate for this computer (pnpm lan makes it)
certs/
# the camera's model files for local mode (pnpm local / pnpm lan download them)
models/

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), plus the project skills in
# .claude/skills/, which hold no secrets. Everything else in here stays local.
.claude/*
!.claude/skills/

# runtime data and test output
data/
playwright-report/
test-results/

# third-party inspiration images stay local (the repo goes public)
design/reference/
data-*/
