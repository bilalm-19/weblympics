{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node -e \"try{require('node:child_process').execFileSync('git',['config','core.hooksPath','.githooks'],{stdio:'ignore'})}catch{}\"",
    "dev:server": "node --watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.ts",
    "local": "pnpm build && node scripts/local.ts",
    "lan": "pnpm build && node scripts/lan.ts",
    "e2e": "playwright test",
    "e2e:gpu": "E2E_GPU=1 GALLIUM_DRIVER=d3d12 MESA_D3D12_DEFAULT_ADAPTER_NAME=NVIDIA LD_LIBRARY_PATH=/usr/lib/wsl/lib playwright test",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@playwright/test": "^1.63.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "jsdom": "^30.1.0",
    "selfsigned": "5.5.0",
    "three": "^0.186.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "marked": "^18.0.14",
    "obscenity": "^0.4.6",
    "ws": "^8.22.0"
  }
}
